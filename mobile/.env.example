# Supabase project connection for the Sporting Ethos mobile app.
# These are the PUBLIC anon/publishable values — safe for a client bundle
# because every table is protected by Row Level Security. Never put the
# service_role / secret key or the Supabase management access token here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
