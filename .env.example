# Copy this file to ".env" and fill in your Supabase project values.
# Supabase dashboard -> Project Settings -> API.
# Without these, the app runs in local demo mode (realtime across browser tabs only).

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Ambient Charting backend (FastAPI + Groq). Optional — defaults to localhost:8000.
# See backend/README.md to run it. Without it, charting shows a labelled sample.
VITE_CHART_API_URL=http://localhost:8000
